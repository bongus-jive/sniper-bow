{
  "projectileName": "pat_sniperbow_muzzleflash",
  "image": "invisible.png",
  "timeToLive": 0.1,
  "onlyHitTerrain": true,
  "damageType": "NoDamage",
  "movementSettings": {
    "collisionEnabled": false,
    "frictionEnabled": false,
    "gravityEnabled": false,
    "speedLimit": 0,
    "physicsEffectCategories": [ ]
  },
  "periodicActions": [
    {
      "action": "actions",
      "time": 0,
      "repeat": false,
      "list": [
        { "action": "sound", "options": [ "/sfx/gun/sniper2.ogg" ] },
        { "action": "sound", "options": [ "/sfx/gun/sniper3.ogg" ] },
        { "action": "particle", "rotate": true, "specification": "pat_sniperbow_case" },
        {
          "action": "loop",
          "count": 3,
          "body": [ { "action": "particle", "specification": "rocketbarrelpuff" } ]
        },
        {
          "action": "particle",
          "rotate": true,
          "specification": {
            "type": "animated",
            "animation": "/pat/sniperbow/particles/muzzleflash.animation",
            "layer": "front",
            "light": [ 180, 120, 0 ],
            "fade": 11,
            "timeToLive": 1,
            "fullbright": true,
            "collidesForeground": false
          }
        }
      ]
    }
  ]
}