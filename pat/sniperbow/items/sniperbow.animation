{
	"animatedParts": {
		"stateTypes": {
			"muzzleFlash": {
				"default": "off",
				"states": {
					"off": { "properties": { "lightsOff": [ "muzzleFlash" ] } },
					"fire": {
						"frames": 2,
						"cycle": 0.06,
						"mode": "transition",
						"transition": "off",
						"properties": { "lightsOn": [ "muzzleFlash" ] }
					}
				}
			}
		},

		"parts": {
			"bow": {
				"properties": {
					"offset": [ 0.9375, 0 ],
					"centered": true,
					"image": "<partImage>:<drawFrame>",
					"transformationGroups": [ "weapon" ]
				}
			},

			"muzzleFlash": {
				"properties": {
					"zLevel": -1,
					"centered": true,
					"offset": [ 4, 0 ],
					"fullbright": true,
					"transformationGroups": [ "weapon" ]
				},
				"partStates": {
					"muzzleFlash": { "fire": { "properties": { "image": "<partImage>:<variant>.<frame>" } } }
				}
			}
		}
	},

	"transformationGroups": {
		"weapon": { }
	},

	"sounds": {
		"draw": [ "/sfx/gun/bow_draw1.ogg", "/sfx/gun/bow_draw2.ogg", "/sfx/gun/bow_draw3.ogg" ],
		"release": [ "/sfx/gun/bow_loose.ogg" ],
		"perfectRelease": [ "/sfx/gun/bow_loose.ogg" ],
		"fire": [ "/sfx/gun/sniper2.ogg" ],
		"fire2": [ "/sfx/gun/sniper3.ogg" ]
	},

	"particleEmitters": {
		"muzzleFlash": {
			"transformationGroups": [ "weapon" ],
			"offsetRegion": [ 3.5, -0.1, 3.6, 0.1 ],
			"particles": [
				{ "particle": "rocketbarrelpuff", "count": 3 },
				{ "particle": "pat_sniperbow_case" }
			]
		}
	},

	"lights": {
		"muzzleFlash": {
			"active": false,
			"position": [ 0, 0 ],
			"color": [ 90, 90, 0 ]
		}
	}
}
